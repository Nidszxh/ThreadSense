# ThreadSense environment configuration (backend)
# Copy to backend/.env (or export) and edit. The app reads .env from its CWD,
# so run uvicorn/celery/alembic from backend/. All values here are the
# defaults from backend/app/config.py except the secrets.

# --- Database / broker (match deploy/docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://threadsense:threadsense@localhost:5432/threadsense
REDIS_URL=redis://localhost:6379/0

# --- LLM (OpenAI-compatible endpoint; required for the summarize chain) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=true
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_BRANCHES=12
# LLM_SUMMARY_MAX_CHARS=30000
# LLM_MAX_COMMENT_CHARS=200
# LLM_MAX_COMMENTS_PER_BRANCH=40

# --- Reddit ingestion (env-provided, never hardcoded) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=threadsense:dev:v0.1

# --- App ---
# ENVIRONMENT=development
